{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoldQuery",
  "version": "0.2.2",
  "identifier": "com.foldquery.app",
  "build": {
    "beforeDevCommand": "bun run fetch-micromamba && bun run dev",
    "devUrl": "http://localhost:3420",
    "beforeBuildCommand": "bun run build && bun run fetch-micromamba",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FoldQuery",
        "width": 1100,
        "height": 750,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/micromamba"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
